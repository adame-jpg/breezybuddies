{{ 'bb-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bb-base.css' | asset_url | stylesheet_tag }}
{{ 'bb-components.css' | asset_url | stylesheet_tag }}
{{ 'bb-pop.css' | asset_url | stylesheet_tag }}
{{ 'bb-commerce.css' | asset_url | stylesheet_tag }}
{{ 'bb-shopify.css' | asset_url | stylesheet_tag }}

{% render 'bb-characters-json' %}

<div class="bb-site" lang="{{ localization.language.iso_code }}">
  <div class="bb-announce">
    <div class="bb-announce__inner">
      <span>{{ 'bb.announce.shipping' | t }}</span>
      <span>{{ 'bb.announce.worldwide' | t }}</span>
      <span>{{ 'bb.announce.returns' | t }}</span>
    </div>
  </div>

  <header class="bb-nav">
    <div class="bb-nav__inner">
      <a class="bb-nav__brand" href="{{ routes.root_url }}">
        <img src="{{ 'bb-logo-circle.png' | asset_url }}" width="42" height="42" alt="{{ 'bb.brand' | t }}">
        {{ 'bb.brand' | t }}
      </a>
      <nav class="bb-nav__links" aria-label="{{ 'bb.nav.primary' | t }}">
        <a href="#shop">{{ 'bb.nav.shop' | t }}</a>
        <a href="#how">{{ 'bb.nav.how' | t }}</a>
        <a href="#reviews">{{ 'bb.nav.reviews' | t }}</a>
        <a href="#faq">{{ 'bb.nav.faq' | t }}</a>
      </nav>
      <div class="bb-nav__actions">
        <button type="button" class="bb-nav__cart-btn" data-bb-open-cart>
          {{ 'bb.nav.cart' | t }}
          <span class="bb-nav__cart-count" data-bb-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <span class="puff puff--1" aria-hidden="true"></span>
      <span class="puff puff--2" aria-hidden="true"></span>
      <span class="puff puff--3" aria-hidden="true"></span>
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <p class="hero__eyebrow eyebrow">{{ 'bb.hero.eyebrow' | t }}</p>
          <h1 class="hero__title">{{ 'bb.hero.title' | t }}</h1>
          <p class="hero__sub">{{ 'bb.hero.sub' | t }}</p>
          <div class="hero__ctas">
            <a class="btn btn--primary btn--lg" href="#shop">{{ 'bb.hero.cta_shop' | t }}</a>
            <a class="btn btn--soft btn--lg" href="#how">{{ 'bb.hero.cta_how' | t }}</a>
          </div>
          <ul class="hero__trust">
            <li>★ {{ 'bb.hero.trust_loved' | t }}</li>
            <li>{{ 'bb.hero.trust_gift' | t }}</li>
            <li>{{ 'bb.hero.trust_chars' | t }}</li>
          </ul>
        </div>
        <div class="hero__media">
          <picture>
            <source media="(max-width: 639px)" srcset="{{ 'bb-hero-mobile.webp' | asset_url }}">
            <img
              src="{{ 'bb-hero.webp' | asset_url }}"
              width="1100"
              height="733"
              alt="{{ 'bb.hero.image_alt' | t }}"
              fetchpriority="high"
            >
          </picture>
        </div>
      </div>
    </section>

    <section class="section section--cream" id="how">
      <div class="wrap">
        <div class="bb-section-shell">
          <header class="sec-head">
            <h2 class="sec-title">{{ 'bb.how.title' | t }}</h2>
            <p class="sec-sub">{{ 'bb.how.sub' | t }}</p>
          </header>
          <ol class="bb-steps">
            <li class="bb-step">
              <span class="bb-step__num bb-step__num--mint">1</span>
              <h3 class="bb-step__title">{{ 'bb.how.step1_title' | t }}</h3>
              <p class="bb-step__body">{{ 'bb.how.step1_body' | t }}</p>
            </li>
            <li class="bb-step">
              <span class="bb-step__num bb-step__num--yellow">2</span>
              <h3 class="bb-step__title">{{ 'bb.how.step2_title' | t }}</h3>
              <p class="bb-step__body">{{ 'bb.how.step2_body' | t }}</p>
            </li>
            <li class="bb-step">
              <span class="bb-step__num bb-step__num--coral">3</span>
              <h3 class="bb-step__title">{{ 'bb.how.step3_title' | t }}</h3>
              <p class="bb-step__body">{{ 'bb.how.step3_body' | t }}</p>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section section--cream" id="shop">
      <div class="wrap">
        <header class="sec-head">
          <h2 class="sec-title">{{ 'bb.shop.title' | t }}</h2>
          <p class="sec-sub">{{ 'bb.shop.sub' | t }}</p>
        </header>

        {% liquid
          assign all_handles = 'mochi,coco,ellie,mango,chili,bao,dino-mint,dino-grape,flip,blossom' | split: ','
          assign all_names = 'Mochi Cat,Coco Pup,Ellie Elephant,Mango Monkey,Chili Red Panda,Bao Panda,Dino Mint,Dino Grape,Flip Frog,Blossom Bunny' | split: ','
          assign all_animal_keys = 'cat,dog,elephant,monkey,red_panda,panda,dino,dino,frog,bunny' | split: ','
          assign all_accents = '#ffd85a,#f5a54a,#7ddbd0,#ff6b8a,#ff8a5b,#e8e0d5,#8ed081,#a78bfa,#8CC63F,#E95E8A' | split: ','
          assign all_softs = '#fff4d0,#ffeed8,#e2f7f4,#ffe3ea,#ffe8de,#f5f1ea,#e7f5e3,#ede7ff,#e9f6d8,#ffe3ea' | split: ','
          assign all_imgs = 'bb-mochi.webp,bb-coco.webp,bb-ellie.webp,bb-coco.webp,bb-ellie.webp,bb-ellie.webp,bb-dino-mint.webp,bb-dino-grape.webp,bb-dino-mint.webp,bb-mochi.webp' | split: ','
          assign all_badge_keys = ', ,most_picked,new,new, , ,new,new,new' | split: ','
          assign all_groups = 'pets,pets,zoo,zoo,zoo,zoo,dinos,dinos,cartoons,cartoons' | split: ','
          assign groups = 'pets,zoo,dinos,cartoons' | split: ','
        %}

        {% for group in groups %}
          {% assign group_key = 'bb.groups.' | append: group %}
          <h3 class="bb-group-title eyebrow">{{ group_key | t }}</h3>
          <div class="grid-cards bb-savor-grid category-grid">
            {% for handle in all_handles %}
              {% assign i = forloop.index0 %}
              {% if all_groups[i] != group %}{% continue %}{% endif %}
              {% assign product = all_products[handle] %}
              {% assign accent = all_accents[i] %}
              {% assign soft = all_softs[i] %}
              {% assign badge_key = all_badge_keys[i] | strip %}
              {% assign animal_key = 'bb.animals.' | append: all_animal_keys[i] %}
              {% assign name = all_names[i] %}
              {% if product != blank %}{% assign name = product.title %}{% endif %}
              <article class="card bb-savor-card" style="--accent:{{ accent }};--accent-soft:{{ soft }}" data-bb-pick="{{ handle }}">
                <a class="card__media" href="{% if product != blank %}{{ product.url }}{% else %}#shop{% endif %}">
                  {% if badge_key != blank %}
                    {% assign badge_t = 'bb.badges.' | append: badge_key %}
                    <span class="card__badge">{{ badge_t | t }}</span>
                  {% endif %}
                  {% if product != blank and product.featured_image %}
                    <img src="{{ product.featured_image | image_url: width: 600 }}" width="450" height="450" alt="{{ name | escape }}" loading="lazy">
                  {% else %}
                    <img src="{{ all_imgs[i] | asset_url }}" width="450" height="450" alt="{{ name | escape }}" loading="lazy">
                  {% endif %}
                  <span class="product-card__tag eyebrow">{{ animal_key | t }}</span>
                </a>
                <div class="card__body">
                  <p class="card__animal eyebrow">{{ animal_key | t }}</p>
                  <h3 class="card__name">{{ name }}</h3>
                  <p class="card__price price">{% if product != blank %}{{ product.price | money }}{% else %}€19.95{% endif %}</p>
                  <ul class="bb-pdp__proof">
                    <li>{{ 'bb.shop.proof_toddlers' | t }}</li>
                  </ul>
                  {% if product != blank %}
                    {% form 'product', product %}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit" class="btn btn--primary btn--block">{{ 'bb.shop.add' | t }}</button>
                    {% endform %}
                    <a class="card__link" href="{{ product.url }}">{{ 'bb.shop.details' | t }}</a>
                  {% else %}
                    <button type="button" class="btn btn--primary btn--block" data-bb-pick="{{ handle }}">
                      {{ 'bb.shop.pick' | t: name: name }}
                    </button>
                  {% endif %}
                </div>
              </article>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </section>

    <section class="section section--warm">
      <div class="wrap family">
        <div class="family__media">
          <img
            src="{{ 'bb-family.webp' | asset_url }}"
            width="700"
            height="467"
            loading="lazy"
            alt="{{ 'bb.family.image_alt' | t }}"
          >
        </div>
        <div>
          <p class="sec-eyebrow eyebrow">{{ 'bb.family.eyebrow' | t }}</p>
          <h2 class="sec-title">{{ 'bb.family.title' | t }}</h2>
          <p>{{ 'bb.family.body' | t }}</p>
          <ul class="family__list">
            <li><span>{{ 'bb.family.li1' | t }}</span></li>
            <li><span>{{ 'bb.family.li2' | t }}</span></li>
            <li><span>{{ 'bb.family.li3' | t }}</span></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section section--cream" id="features">
      <div class="wrap">
        <div class="bb-section-shell bb-section-shell--mint">
          <header class="sec-head">
            <h2 class="sec-title">{{ 'bb.features.title' | t }}</h2>
          </header>
          <div class="grid-features bb-panel-grid">
            <article class="feat bb-panel">
              <h3 class="feat__title">{{ 'bb.features.air_title' | t }}</h3>
              <p>{{ 'bb.features.air_body' | t }}</p>
            </article>
            <article class="feat bb-panel">
              <h3 class="feat__title">{{ 'bb.features.usb_title' | t }}</h3>
              <p>{{ 'bb.features.usb_body' | t }}</p>
            </article>
            <article class="feat bb-panel">
              <h3 class="feat__title">{{ 'bb.features.chars_title' | t }}</h3>
              <p>{{ 'bb.features.chars_body' | t }}</p>
            </article>
            <article class="feat bb-panel">
              <h3 class="feat__title">{{ 'bb.features.gift_title' | t }}</h3>
              <p>{{ 'bb.features.gift_body' | t }}</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--white" id="ugc">
      <div class="wrap">
        <header class="sec-head">
          <h2 class="sec-title">{{ 'bb.ugc.title' | t }}</h2>
          <p class="sec-sub">{{ 'bb.ugc.sub' | t }}</p>
        </header>
        <div class="bb-ugc" data-bb-ugc>
          <button type="button" class="bb-ugc__nav bb-ugc__nav--prev" data-bb-ugc-prev aria-label="Previous">‹</button>
          <div class="bb-ugc__track" data-bb-ugc-track>
            <figure class="bb-ugc__card bb-ugc__card--video">
              <img src="{{ 'bb-ugc-soup.webp' | asset_url }}" alt="{{ 'bb.ugc.soup' | t }}" width="360" height="480" loading="lazy">
              <button type="button" class="bb-ugc__play" aria-label="{{ 'bb.ugc.video_label' | t }}">▶</button>
              <figcaption>{{ 'bb.ugc.soup' | t }}</figcaption>
            </figure>
            <figure class="bb-ugc__card">
              <img src="{{ 'bb-ugc-cocoa.webp' | asset_url }}" alt="{{ 'bb.ugc.cocoa' | t }}" width="360" height="480" loading="lazy">
              <figcaption>{{ 'bb.ugc.cocoa' | t }}</figcaption>
            </figure>
            <figure class="bb-ugc__card bb-ugc__card--video">
              <img src="{{ 'bb-ugc-breakfast.webp' | asset_url }}" alt="{{ 'bb.ugc.breakfast' | t }}" width="360" height="480" loading="lazy">
              <button type="button" class="bb-ugc__play" aria-label="{{ 'bb.ugc.video_label' | t }}">▶</button>
              <figcaption>{{ 'bb.ugc.breakfast' | t }}</figcaption>
            </figure>
            <figure class="bb-ugc__card">
              <img src="{{ 'bb-on-mug.webp' | asset_url }}" alt="{{ 'bb.ugc.mug' | t }}" width="360" height="480" loading="lazy">
              <figcaption>{{ 'bb.ugc.mug' | t }}</figcaption>
            </figure>
            <figure class="bb-ugc__card">
              <img src="{{ 'bb-lineup.webp' | asset_url }}" alt="{{ 'bb.ugc.lineup' | t }}" width="360" height="480" loading="lazy">
              <figcaption>{{ 'bb.ugc.lineup' | t }}</figcaption>
            </figure>
            <figure class="bb-ugc__card">
              <img src="{{ 'bb-family.webp' | asset_url }}" alt="{{ 'bb.family.image_alt' | t }}" width="360" height="480" loading="lazy">
              <figcaption>{{ 'bb.family.eyebrow' | t }}</figcaption>
            </figure>
          </div>
          <button type="button" class="bb-ugc__nav bb-ugc__nav--next" data-bb-ugc-next aria-label="Next">›</button>
        </div>
      </div>
    </section>

    <section class="section section--cream" id="bundles">
      <div class="wrap">
        <header class="sec-head">
          <h2 class="sec-title">{{ 'bb.bundles.title' | t }}</h2>
          <p class="sec-sub">{{ 'bb.bundles.sub' | t }}</p>
        </header>
        <div class="bb-bundle-grid">
          <button type="button" class="bb-bundle-card" data-bb-pdp-bundle="single" aria-pressed="false">
            <p class="bb-bundle-card__title">{{ 'bb.bundles.single_title' | t }}</p>
            <p class="bb-bundle-card__sub">{{ 'bb.bundles.single_sub' | t }}</p>
            <p class="bb-bundle-card__price price">€19.95</p>
          </button>
          <button type="button" class="bb-bundle-card" data-bb-pdp-bundle="duo" aria-pressed="false">
            <p class="bb-bundle-card__title">{{ 'bb.bundles.duo_title' | t }}</p>
            <p class="bb-bundle-card__sub">{{ 'bb.bundles.duo_sub' | t }}</p>
            <p class="bb-bundle-card__price price">€34.91</p>
          </button>
          <button type="button" class="bb-bundle-card is-featured" data-bb-pdp-bundle="family" aria-pressed="true">
            <span class="bb-bundle-card__tag">{{ 'bb.bundles.family_tag' | t }}</span>
            <p class="bb-bundle-card__title">{{ 'bb.bundles.family_title' | t }}</p>
            <p class="bb-bundle-card__sub">{{ 'bb.bundles.family_sub' | t }}</p>
            <p class="bb-bundle-card__price price">€47.88</p>
            <span class="tier-tag tier-tag--shipping">{{ 'bb.bundles.free_shipping_tag' | t }}</span>
          </button>
        </div>
        {% render 'bb-trust-badges' %}
      </div>
    </section>

    <section class="section section--mint-soft" id="reviews">
      <div class="wrap">
        <div class="bb-section-shell bb-early">
          <header class="sec-head">
            <h2 class="sec-title">{{ 'bb.early.title' | t }}</h2>
            <p class="sec-sub">{{ 'bb.early.body' | t }}</p>
          </header>
          <p class="bb-early__cta-wrap">
            <a class="btn btn--primary btn--lg" href="#shop">{{ 'bb.early.cta' | t }}</a>
          </p>
        </div>
      </div>
    </section>

    <section class="section section--white" id="faq">
      <div class="wrap wrap--narrow bb-compact">
        <header class="sec-head">
          <h2 class="sec-title">{{ 'bb.faq.title' | t }}</h2>
          <p class="sec-sub">{{ 'bb.faq.sub' | t }}</p>
        </header>
        {% render 'bb-faq-trust', mode: 'faq' %}
      </div>
    </section>

    <section class="section section--cream" id="trust">
      <div class="wrap">
        <div class="bb-section-shell">
          <header class="sec-head">
            <h2 class="sec-title">{{ 'bb.trust.title' | t }}</h2>
          </header>
          {% render 'bb-faq-trust', mode: 'trust' %}
        </div>
      </div>
    </section>

    <section class="section section--mint-soft section--tight">
      <div class="wrap">
        <div class="news">
          <h2 class="news__title">{{ 'bb.newsletter.title' | t }}</h2>
          <p class="news__body">{{ 'bb.newsletter.body' | t }}</p>
          {% form 'customer', class: 'news__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter,breezy-club">
            <label class="visually-hidden" for="bb-news-email">{{ 'bb.newsletter.email_label' | t }}</label>
            <input id="bb-news-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'bb.newsletter.email_placeholder' | t }}">
            <button type="submit" class="btn btn--primary btn--lg">{{ 'bb.newsletter.cta' | t }}</button>
          {% endform %}
          <p class="news__privacy">{{ 'bb.newsletter.privacy' | t }}</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="bb-footer">
    <div class="bb-footer__inner">
      <div>
        <div class="bb-footer__brand">
          <img src="{{ 'bb-logo-circle.png' | asset_url }}" alt="" width="48" height="48">
          {{ 'bb.brand' | t }}
        </div>
        <p>{{ 'bb.footer.blurb' | t }}</p>
      </div>
      <div class="bb-footer__cols">
        <div>
          <h4>{{ 'bb.footer.shop' | t }}</h4>
          <a href="#shop">{{ 'bb.footer.all' | t }}</a>
          <a href="#bundles">{{ 'bb.footer.sets' | t }}</a>
        </div>
        <div>
          <h4>{{ 'bb.footer.help' | t }}</h4>
          <a href="#faq">{{ 'bb.nav.faq' | t }}</a>
          <a href="#how">{{ 'bb.nav.how' | t }}</a>
          <a href="mailto:{{ shop.email }}">{{ 'bb.footer.contact' | t }}</a>
        </div>
        <div>
          <h4>{{ 'bb.footer.company' | t }}</h4>
          <a href="{{ routes.root_url }}">{{ 'bb.footer.home' | t }}</a>
          <a href="{{ routes.cart_url }}">{{ 'bb.footer.cart' | t }}</a>
        </div>
      </div>
      {% assign bb_year = 'now' | date: '%Y' %}
      <p class="bb-footer__copy">{{ 'bb.footer.copy' | t: year: bb_year }}</p>
    </div>
  </footer>
</div>

{% if cart.item_count > 0 %}
  {% render 'bb-sticky-quick-add' %}
{% endif %}
{% render 'bb-cart-drawer' %}
<script src="{{ 'bb-commerce.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Breezy landing",
  "tag": "section",
  "class": "bb-landing-section",
  "settings": [],
  "presets": [{ "name": "Breezy landing" }]
}
{% endschema %}
