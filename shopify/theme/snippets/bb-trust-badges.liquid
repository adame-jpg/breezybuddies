{%- comment -%} Certification / safety badges under ATC {%- endcomment -%}
<ul class="bb-cert" aria-label="{{ 'bb.cert.label' | t }}">
  <li class="bb-cert__item trust-badge-card">
    <span class="bb-cert__icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 9.5C8 19.2 5 15.5 5 11V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
    </span>
    <span>{{ 'bb.cert.bpa' | t }}</span>
  </li>
  <li class="bb-cert__item trust-badge-card">
    <span class="bb-cert__icon" aria-hidden="true">
      {%- comment -%} Fan / soft rotor {%- endcomment -%}
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12c2.5-3.5 6.5-4 8-2.2 1.4 1.7-.1 4.7-3.5 5.7"/><path d="M12 12c-3.5-2.5-4-6.5-2.2-8 1.7-1.4 4.7.1 5.7 3.5"/><path d="M12 12c-2.5 3.5-6.5 4-8 2.2-1.4-1.7.1-4.7 3.5-5.7"/><path d="M12 12c3.5 2.5 4 6.5 2.2 8-1.7 1.4-4.7-.1-5.7-3.5"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/></svg>
    </span>
    <span>{{ 'bb.cert.rotor' | t }}</span>
  </li>
  <li class="bb-cert__item trust-badge-card">
    <span class="bb-cert__icon" aria-hidden="true">
      {%- comment -%} Battery charging / USB rechargeable {%- endcomment -%}
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="7" width="12" height="14" rx="2"/><path d="M10 7V5h4v2"/><path d="M11 16l2-4h-2l2-4"/></svg>
    </span>
    <span>{{ 'bb.cert.usb' | t }}</span>
  </li>
</ul>
<p class="bb-ship-line">{{ 'bb.ship_line' | t }}</p>
{% render 'bb-payment-icons' %}
